#!/usr/bin/env bash
set -Eeuo pipefail

# Mirror the useful part of the Hyprland login layout. Wait for Yabai's command
# socket instead of guessing startup timing, then let its rules place apps.
if command -v yabai >/dev/null 2>&1; then
    for _ in {1..20}; do
        yabai -m query --spaces >/dev/null 2>&1 && break
        sleep 1
    done
fi

open -na Kitty
open -a Firefox
open -a Telegram
