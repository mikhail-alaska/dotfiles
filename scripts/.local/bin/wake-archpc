#!/usr/bin/env python3
"""Send a Wake-on-LAN magic packet to ArchPC."""

from __future__ import annotations

import argparse
import socket


DEFAULT_MAC = "50:EB:F6:9E:F0:81"
DEFAULT_BROADCAST = "192.168.0.255"


def magic_packet(mac: str) -> bytes:
    normalized = mac.replace(":", "").replace("-", "")
    if len(normalized) != 12:
        raise ValueError(f"invalid MAC address: {mac}")
    hardware_address = bytes.fromhex(normalized)
    return b"\xff" * 6 + hardware_address * 16


def main() -> None:
    parser = argparse.ArgumentParser(description="Wake ArchPC over the local LAN")
    parser.add_argument("--mac", default=DEFAULT_MAC)
    parser.add_argument("--broadcast", default=DEFAULT_BROADCAST)
    args = parser.parse_args()

    packet = magic_packet(args.mac)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for port in (9, 7):
            for _ in range(3):
                sock.sendto(packet, (args.broadcast, port))

    print(f"Wake packet sent to {args.mac} via {args.broadcast}")


if __name__ == "__main__":
    main()
