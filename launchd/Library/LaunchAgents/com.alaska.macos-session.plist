<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alaska.macos-session</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>mkdir -p "$HOME/Library/Logs"; exec "$HOME/.local/bin/macos-session" &gt;&gt;"$HOME/Library/Logs/com.alaska.macos-session.out.log" 2&gt;&gt;"$HOME/Library/Logs/com.alaska.macos-session.err.log"</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
