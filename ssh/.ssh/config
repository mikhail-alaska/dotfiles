# Host-specific configuration imported from Archpad lives outside Git.
Include ~/.ssh/private.d/*.conf

Host archpad
    HostName 192.168.0.22
    User alaska
    IdentityFile ~/.ssh/archpad_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    UserKnownHostsFile ~/.ssh/known_hosts.archpad

Host *
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
    UseKeychain yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
